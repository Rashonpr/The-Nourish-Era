# ─── Supabase ────────────────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard.
# The anon key is safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_,
# never import it into client code. Used only for trusted maintenance tasks
# (e.g. syncing the shared USDA food cache).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Claude API ──────────────────────────────────────────────────────────
# Server only. Never exposed to the browser — all calls go through
# app/api/ai/* route handlers.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Defaults to claude-opus-5 if unset — see src/lib/services/claude/client.ts.
ANTHROPIC_MODEL=

# ─── USDA FoodData Central ───────────────────────────────────────────────
# Free key from https://fdc.nal.usda.gov/api-key-signup.html
# Server only — requests are proxied through app/api/nutrition/*.
USDA_FDC_API_KEY=your-usda-fdc-api-key

# ─── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
